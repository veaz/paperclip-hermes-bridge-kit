# Paperclip API base URL. Local self-hosted default:
PAPERCLIP_API_BASE=http://127.0.0.1:3006

# Optional. If your Paperclip instance requires auth, put a board/operator API key here.
# Never commit the real value. Copy this file to .env and fill locally.
PAPERCLIP_API_KEY=

# Paperclip company/workspace ID.
PAPERCLIP_COMPANY_ID=

# Optional defaults for issue creation examples.
PAPERCLIP_PROJECT_ID=
PAPERCLIP_ASSIGNEE_AGENT_ID=
